# Copy to .env and adjust: cp .env.example .env
# .env is git-ignored. Never commit real credentials.

# --- App ---
APP_ENV=development
APP_PORT=8080

# --- PostgreSQL ---
# DB_HOST/DB_PORT are used when running the API on the host (go run).
# Inside docker compose the API always reaches postgres at postgres:5432.
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=task_management
DB_SSLMODE=disable
# Host port that docker compose publishes postgres on (5432 is often taken by a local install).
DB_HOST_PORT=5433

# --- JWT ---
# Generate a strong secret, e.g.: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=24h

# --- Super admin (seeded on startup) ---
SUPERADMIN_NAME=Super Admin
SUPERADMIN_EMAIL=superadmin@mail.com
SUPERADMIN_PASSWORD=password123

# --- Idempotency ---
IDEMPOTENCY_TTL=24h
IDEMPOTENCY_WAIT_TIMEOUT=10s
IDEMPOTENCY_POLL_INTERVAL=100ms

# --- Pagination ---
PAGINATION_DEFAULT_LIMIT=10
PAGINATION_MAX_LIMIT=50
